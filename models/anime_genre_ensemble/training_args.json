{
  "run_id": "anime_genre_ensemble",
  "seed": 42,
  "dataset": "OtakuDB (MyAnimeList, March 2025)",
  "dataset_source": "https://github.com/Debojit-mitra/OtakuDB",
  "n_train": 10236,
  "n_test": 2559,
  "n_genres": 42,
  "genres": [
    "Comedy",
    "Action",
    "Fantasy",
    "Adventure",
    "Sci-Fi",
    "Drama",
    "Shounen",
    "Romance",
    "School",
