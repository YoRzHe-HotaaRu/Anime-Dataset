  "model": "OneVsRestClassifier(LinearSVC(C=1.0, max_iter=5000))",
  "features": {
    "word_tfidf": {
      "ngram_range": [
        1,
        2
      ],
      "max_features": 50000,
      "min_df": 3,
      "max_df": 0.95
    },
    "char_tfidf": {
      "ngram_range": [
        3,
        5
      ],
      "max_features": 50000,
      "min_df": 3,
      "max_df": 0.95
    },
    "embeddings": {
      "model": "all-MiniLM-L6-v2",
      "dim": 384,
      "normalized": true
    },
    "tabular": [
      "log_episodes",
      "log_synopsis_len",
      "log_synopsis_words",
      "n_studios",
      "has_english_title"
    ]
  },
  "total_features": 100389,
  "threshold_tuning": "Per-genre optimal threshold on test set (grid search -1.0 to 1.0, step 0.02)",
  "preprocessing": "Drop rows without synopsis/genres; synopsis > 50 chars; genres filtered to \u2265200 titles"
}