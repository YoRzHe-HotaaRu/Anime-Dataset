    "Mecha",
    "Historical",
    "Seinen",
    "Slice of Life",
    "Mystery",
    "Ecchi",
    "Music",
    "Military",
    "Adult Cast",
    "Sports",
    "Parody",
    "Super Power",
    "Shoujo",
    "Space",
    "Mythology",
    "Martial Arts",
    "Horror",
    "Harem",
    "Suspense",
    "Psychological",
    "Isekai",
    "Avant Garde",
